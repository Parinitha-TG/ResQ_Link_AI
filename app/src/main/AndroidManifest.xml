<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.resqlink_ai">

    <!-- 🔐 PERMISSIONS -->

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- SMS -->
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- Internet (Firebase) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Optional (better GPS performance) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="ResQLink AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ResQLinkAI">

        <!-- 🗺️ Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAP34T1LO6aW7WqesFqLmjnYPQdcKJlREk"/>

        <!-- 🔴 MAIN SCREEN -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- 🚨 PRE-ALERT SCREEN (Countdown to cancel) -->
        <activity
            android:name=".PreAlertActivity"
            android:exported="false"/>

        <!-- 🚨 ALERT SCREEN -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"/>

    </application>

</manifest>