<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF0000"/>
            <size android:width="240dp" android:height="240dp"/>
        </shape>
    </item>

    <!-- Middle Glow -->
    <item android:left="20dp" android:top="20dp"
        android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#66FF0000"/>
        </shape>
    </item>

    <!-- Inner Circle -->
    <item android:left="40dp" android:top="40dp"
        android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <solid android:color="#B00000"/>
        </shape>
    </item>

</layer-list>